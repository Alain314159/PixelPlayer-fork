# ktlint baseline file — generated by ktlint --baseline=...
# This file records existing ktlint violations so that the ktlint job in CI
# does not fail on pre-existing style debt. New code is still required to pass.
#
# To regenerate: java -jar ktlint.jar "app/src/**/*.kt" --baseline=.ktlint-baseline.xml --relative
# To view violations: java -jar ktlint.jar "app/src/**/*.kt" --relative

<?xml version="1.0" encoding="UTF-8"?>
<baseline version="1.0">
    <!-- ktlint will populate this file on first run with --apply or --baseline -->
    <!-- Empty file means ktlint will report all violations as new (fail-fast mode). -->
</baseline>
